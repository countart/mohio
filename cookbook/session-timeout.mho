// Copyright 2026 Particular LLC. MOHIO(TM) is a trademark of Particular LLC.
// Session timeout -- lock the page when nobody is there, and let the person back
// in with a link sent to their email. The browser half and the server half of the
// same story, and both halves are Mohio.
// Run it:  mio serve cookbook/session-timeout.mho   (uses SQLite in memory)
//
// No email account is needed to try it. With no provider configured miomail does
// not send anything and nothing leaves the machine, so the flow runs end to end
// on your laptop. To send real email set SENDGRID_API_KEY, BREVO_API_KEY, or
// SMTP_HOST. Note that a handler's own `show` is not echoed by mio serve. To watch a
// step print while you are learning it, drive ONE request from the command line:
//   mio run cookbook/session-timeout.mho --request '{"_path":"/","_method":"GET"}'
// A bare `mio run` prints nothing here and that is correct: this file is listeners only,
// so with no request to answer there is nothing for it to do.

connect db as sqlite from env.DATABASE_URL default "app.db"

shape Relogin
    email as text required format "email"
shape: done

shape Back
    token as text required
shape: done

// The browser half. Nobody has moved, typed, scrolled, clicked or touched
// anywhere on this page for 25 minutes, so cover it and ask.
on.idle 25 minutes
    show #relogin
on.idle: done

request for sh.Relogin at /
    render
        <h1>The ledger</h1>
        <p>Your work is here.</p>
        <div id="relogin" hidden>
          <h2>Still there?</h2>
          <p>For your security this page locked itself. Send yourself a link to carry on.</p>
          {{ form sh.Relogin }}
        </div>
    render: done
request: done

// Ask for a link. The token is what proves it was really them. Mohio makes it, keeps
// only its fingerprint (never the token), and lets it work once, for this purpose, for
// fifteen minutes. To use it elsewhere: mioauth.token.create, then verify token.
listen for sh.Relogin at /relogin
    mioauth.token.create as link_token
        for Relogin.email
        scope "relogin"
        expires in 15 minutes
        one time
    mioauth.token.create: done
    miomail.send
        to Relogin.email
        subject "Your link back to the ledger"
        body ("Open this to carry on: /back?token=" & link_token)
    give back [200] "Check your email for the link back."
listen: done

// Opening the link only asks. Mail scanners open links on their own, so the link
// itself never signs anyone in: here it is checked, not used, and the button below
// sends it back. An unknown, used or expired link is refused by name.
request for sh.Back at /back
    verify token from Back.token as grant
        scope "relogin"
        on.failure
            give back [401] "That link is not one we sent, or it was used or has expired."
        on.success
            render
                <p>Carry on as {{ grant.for }}?</p>
                {{ form sh.Back }}
            render: done
    verify: done
request: done

// Pressing the button redeems the link, once. Two presses at the same moment cannot
// both get in: the database decides which one used it.
listen for sh.Back at /back
    verify token from Back.token as grant
        scope "relogin"
        on.failure
            give back [401] "That link is not one we sent, or it was used or has expired."
        on.success
            grant role "member"
            give back [200] "Welcome back."
    verify: done
listen: done
